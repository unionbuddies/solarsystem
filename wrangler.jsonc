{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solarsystem",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "solarsystem.space-bound.org", "custom_domain": true }]
}
